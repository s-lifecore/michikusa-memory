# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (Server)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Cloudinary Configuration (Optional for MVP)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
NEXT_PUBLIC_CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# CLOUDINARY_URL=cloudinary://<your_api_key>:<your_api_secret>@dpm2sszur # サーバーサイドのみ（公開禁止）

# AI - ミッション生成
# Google Generative AI (Gemini API)
# 推奨: AI_PROVIDER_API_KEY（標準）または GEMINI_API_KEY（後方互換）
# 取得: https://aistudio.google.com/apikey
AI_PROVIDER_API_KEY=
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash # オプション：モデル指定（デフォルト: gemini-3.8-flash）

# 外部位置情報 API（無料・認証不要）
# Nominatim API（Open Street Map）: リバースジオコーディング
# - URL: https://nominatim.openstreetmap.org/reverse
# - 用途: 緯度経度から国コード・地域情報を取得
# - 認証: 不要
# - ノート: クライアント側で自動利用（環境変数不要）

# タイムゾーン・現地時刻取得
# - ブラウザ標準 API（Intl.DateTimeFormat）を使用
# - 外部 API への依存なし

# Gemini Model
GEMINI_MODEL=

# カスタムドメイン設定
NEXT_PUBLIC_SITE_URL=

# 管理者機能
ADMIN_JWT_SECRET=
ADMIN_SETUP_TOKEN=

# Firebase Admin SDK (サーバーサイドのみ)
# 注: これらの環境変数が未設定の場合、JSONファイルから自動的に読み込まれます
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=