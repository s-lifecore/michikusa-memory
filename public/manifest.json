    "background_color": "#fafafa",
    "theme_color": "#00bcd4",
    "orientation": "portrait",
    "color_scheme": "light",
    "categories": [
        "health",
        "fitness",
        "lifestyle",
        "photography"
    ],
    "lang": "ja",
    "dir": "ltr",
    "prefer_related_applications": false,
    "icons": [
        {
            "src": "/app_icon_joyful_stroll.png",
            "sizes": "any",
            "type": "image/png",
            "purpose": "any maskable"
        }
    ],
    "permissions": ["camera"],
    "screenshots": [],
    "serviceworker": {
        "src": "/sw.js",
        "scope": "/"
    },
    "shortcuts": [
        {
            "name": "ミッションを受ける",
            "short_name": "ミッション",
            "description": "今日のミッションを受信する",
            "url": "/oracle?source=shortcut",
            "icons": [{"src": "/app_icon_joyful_stroll.png", "sizes": "any", "type": "image/png"}]
        },
        {
            "name": "冒険の書",
