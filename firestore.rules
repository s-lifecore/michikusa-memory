rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // users コレクション
    // カスタムクレーム（userId）でログイン済みユーザー本人のみアクセス可
    // 管理者操作はすべて Firebase Admin SDK (API ルート) 経由で行うため、
    // クライアント直アクセスは本人に限定する
    match /users/{userId} {
      allow read, write: if request.auth != null
        && request.auth.token.userId == userId;

      // logs サブコレクション
      match /logs/{logId} {
        allow read, write: if request.auth != null
          && request.auth.token.userId == userId;
      }
    }

    // admins コレクション
    match /admins/{adminId} {
      allow read: if request.auth != null && request.auth.uid == adminId;
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'superadmin';
    }

    // contacts コレクション（管理者アクセス）
    match /contacts/{contactId} {
      allow read, update: if request.auth != null && 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow create: if true;
      allow delete: if request.auth != null && 
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'superadmin';
    }

    // statistics コレクション
    match /statistics/{docId} {
      allow read: if request.auth != null && 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow write: if false;  // Cloud Functions のみ書き込み
    }

    // settings コレクション
    match /settings/{docId} {
      allow read: if request.auth != null && 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'superadmin';
    }

    // audit-logs コレクション
    match /audit-logs/{auditId} {
      allow read: if request.auth != null && 
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'superadmin';
      allow write: if false;  // Cloud Functions のみ
    }

    // notifications コレクション
    match /notifications/{notificationId} {
      allow read, write: if request.auth != null && 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
  }
}
